{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melolingua.com/schemas/public-language-story-v1.json",
  "title": "MeloLingua Public Language Story",
  "description": "One CEFR-graded story from the public MeloLingua learning catalogue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dataset_version",
    "title",
    "language",
    "cefr_level",
    "canonical_url",
    "sentences",
    "vocabulary",
    "pre_reading_vocabulary",
    "language_notes",
    "comprehension_questions",
    "sentence_building",
    "provenance",
    "dataset_semantic_hash",
    "license"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(de|es|fr|it|ko|ru)-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dataset_version": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": ["string", "null"] },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "locale", "script"],
      "properties": {
        "code": { "enum": ["de", "es", "fr", "it", "ko", "ru"] },
        "name": { "enum": ["German", "Spanish", "French", "Italian", "Korean", "Russian"] },
        "locale": { "type": "string", "minLength": 2 },
        "script": { "enum": ["Latin", "Hangul", "Cyrillic"] }
      }
    },
    "cefr_level": { "enum": ["A1", "A2", "B1", "B2"] },
    "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://melolingua\\.com/learn-" },
    "summary": { "type": ["string", "null"] },
    "reading_minutes": { "type": ["number", "null"], "minimum": 0 },
    "word_count": { "type": ["integer", "null"], "minimum": 0 },
    "themes": { "type": "array", "items": { "type": "string" } },
    "setting_tags": { "type": "array", "items": { "type": "string" } },
    "grammar_focus": { "type": "array", "items": { "type": "string" } },
    "communicative_outcome": { "type": ["string", "null"] },
    "target_phrases": { "type": "array", "items": { "type": "string" } },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "translation"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 1 },
          "translation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "lemma", "translation", "sentence_id", "part_of_speech", "details", "example"],
        "properties": {
          "id": { "type": "string" },
          "surface": { "type": "string", "minLength": 1 },
          "lemma": { "type": "string" },
          "translation": { "type": "string", "minLength": 1 },
          "sentence_id": { "type": ["string", "null"] },
          "part_of_speech": { "type": ["string", "null"] },
          "details": { "type": ["string", "null"] },
          "example": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "translation"],
                "properties": {
                  "text": { "type": "string" },
                  "translation": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "pre_reading_vocabulary": { "type": "array", "items": { "type": "object" } },
    "language_notes": { "type": "array", "items": { "type": "object" } },
    "comprehension_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "choices", "correct_index", "explanation"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "choices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "correct_index": { "type": "integer", "minimum": 0 },
          "explanation": { "type": ["string", "null"] }
        }
      }
    },
    "sentence_building": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sentence_id", "prompt_tokens", "answer", "translation"],
        "properties": {
          "id": { "type": "string" },
          "sentence_id": { "type": "string" },
          "prompt_tokens": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "answer": { "type": "string", "minLength": 1 },
          "translation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_story_id",
        "source_hash",
        "canonical_url",
        "exported_at"
      ],
      "properties": {
        "origin": { "const": "melolingua-public-story-catalogue" },
        "source_story_id": { "type": "string" },
        "source_hash": { "type": "string", "minLength": 8 },
        "canonical_url": { "type": "string", "format": "uri" },
        "exported_at": { "type": "string", "format": "date" }
      }
    },
    "dataset_semantic_hash": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "license": { "const": "CC BY-NC 4.0" }
  }
}
